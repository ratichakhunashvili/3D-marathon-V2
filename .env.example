# ---------- Database (Neon, free tier) ----------
DATABASE_URL=""

# ---------- App secret: signs sessions + encrypts the stored Google token ----------
APP_SECRET=""

# ---------- First admin account (created by: npm run seed) ----------
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""

# ---------- Google Drive (fill in after following docs/SETUP-GOOGLE-DRIVE.md) ----------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Must exactly match the redirect URI registered in Google Cloud Console:
GOOGLE_REDIRECT_URI="http://localhost:3100/api/drive/callback"

# ---------- Where uploads land in Drive ----------
# Paste a Drive folder link/id to pin uploads there (needs the full `drive` scope),
# or leave empty to let the app create and manage its own folder.
GOOGLE_DRIVE_ROOT_ID=""

# ---------- Public base URL (used for absolute links) ----------
APP_BASE_URL="http://localhost:3100"

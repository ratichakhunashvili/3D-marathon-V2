{
  "name": "modelhub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build",
    "start": "next start --port 3100",
    "lint": "eslint",
    "db:migrate": "node --import ./scripts/register.mjs --env-file=.env.local scripts/migrate.ts",
    "db:seed": "node --import ./scripts/register.mjs --env-file=.env.local scripts/seed.ts",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "check": "node --import ./scripts/register.mjs --env-file=.env.local scripts/healthcheck.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.186.0",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.4",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "pg": "^8.23.0",
    "typescript": "^5"
  },
  "type": "module"
}
